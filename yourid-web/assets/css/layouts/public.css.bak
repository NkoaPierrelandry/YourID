.public-nav {
  position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,0.9); backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border); padding: 14px 24px; display: flex; align-items: center; justify-content: space-between;
}
.public-nav-logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 18px; }
.public-nav-logo .mark { width: 32px; height: 32px; border-radius: 8px; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 13px; }
.public-nav-actions { display: flex; gap: 8px; }

.public-container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }

/* Hero */
.hero { padding: 80px 24px 60px; text-align: center; background: linear-gradient(180deg, var(--brand-50) 0%, #fff 100%); }
.hero h1 { font-size: 40px; font-weight: 800; color: #0F172A; max-width: 680px; margin: 0 auto 16px; line-height: 1.2; }
.hero p { font-size: 17px; color: var(--text-muted); max-width: 560px; margin: 0 auto 28px; }
.hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
@media (max-width: 640px) { .hero h1 { font-size: 28px; } }

/* Feature grid (landing) */
.feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; padding: 60px 0; }
@media (max-width: 768px) { .feature-grid { grid-template-columns: 1fr; } }
.feature-card { text-align: center; padding: 24px; }
.feature-icon { width: 48px; height: 48px; border-radius: 14px; background: var(--brand-50); color: var(--brand); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
.feature-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
.feature-card p { font-size: 14px; color: var(--text-muted); }

/* Store header */
.store-banner { height: 180px; background: var(--muted); background-size: cover; background-position: center; }
.store-header { display: flex; align-items: flex-end; gap: 16px; padding: 0 24px; margin-top: -40px; margin-bottom: 24px; }
.store-logo { width: 88px; height: 88px; border-radius: 20px; background: var(--brand); color: #fff; font-weight: 700; font-size: 26px; display: flex; align-items: center; justify-content: center; border: 4px solid #fff; flex-shrink: 0; }
.store-logo img { width: 100%; height: 100%; object-fit: cover; border-radius: 16px; }
.store-title { font-size: 24px; font-weight: 800; margin: 0; }
.store-desc { font-size: 14px; color: var(--text-muted); max-width: 520px; }

/* Grille produits */
.product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; padding: 24px 0 60px; }
@media (max-width: 1023px) { .product-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) { .product-grid { grid-template-columns: 1fr; } }

.product-card { border: 1px solid var(--border); border-radius: 18px; overflow: hidden; background: #fff; transition: box-shadow 0.2s ease, transform 0.2s ease; }
.product-card:hover { box-shadow: var(--shadow-soft); transform: translateY(-2px); }
.product-card-cover { height: 150px; background: var(--muted); display: flex; align-items: center; justify-content: center; color: #94A3B8; overflow: hidden; }
.product-card-cover img { width: 100%; height: 100%; object-fit: cover; }
.product-card-body { padding: 14px; }
.product-card-title { font-size: 14px; font-weight: 600; margin: 0 0 6px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.product-card-price { font-size: 15px; font-weight: 700; color: var(--brand-dark); }
.product-card-meta { font-size: 12px; color: var(--text-muted); margin-top: 4px; }

/* Fiche produit */
.product-detail { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding: 40px 0; }
@media (max-width: 767px) { .product-detail { grid-template-columns: 1fr; } }
.product-detail-cover { border-radius: 20px; overflow: hidden; background: var(--muted); aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; color: #94A3B8; }
.product-detail-cover img { width: 100%; height: 100%; object-fit: cover; }
.product-detail-price { font-size: 30px; font-weight: 800; color: #0F172A; margin: 12px 0; }
.review-row { padding: 14px 0; border-bottom: 1px solid var(--border); }
.review-row:last-child { border-bottom: none; }
.stars { color: #F59E0B; font-size: 14px; letter-spacing: 2px; }

.public-footer { border-top: 1px solid var(--border); padding: 32px 24px; text-align: center; font-size: 13px; color: var(--text-muted); }
.public-footer a { color: var(--text-muted); margin: 0 8px; }
.public-footer a:hover { color: var(--brand-dark); }

.checkout-summary-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 14px; }
.checkout-summary-row:last-child { border-bottom: none; font-weight: 700; }