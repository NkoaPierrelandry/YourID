<!DOCTYPE html>
<html lang="fr">
<head>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paramètres — YourID</title>
  <link rel="stylesheet" href="../assets/css/base/tokens.css">
  <link rel="stylesheet" href="../assets/css/base/components.css">
  <link rel="stylesheet" href="../assets/css/layouts/dashboard.css">
  <link rel="stylesheet" href="../assets/css/layouts/dashboard-ui.css">
  <link rel="stylesheet" href="../assets/css/pages/dashboard-settings.css">
</head>
<body>
  <div class="dash-shell">
    <aside id="sidebar-root"></aside>
    <div class="dash-main">
      <header id="header-root"></header>
      <main class="dash-content settings-page-content">

        <div class="settings-page-title">
          <h1 class="page-title">Paramètres</h1>
        </div>

        <div class="pill-row" id="settings-tabs">
          <button class="pill active" data-tab="profile">Profil</button>
          <button class="pill" data-tab="store">Boutique</button>
          <button class="pill" data-tab="payment">Paiement</button>
          <button class="pill" data-tab="security">Sécurité</button>
        </div>

        <!-- Onglet Profil -->
        <section class="card settings-card" id="tab-profile" style="width:min(100%, 470px); max-width:470px; margin-inline:auto;">
          <div class="settings-section-header">
            <h2 class="settings-section-title">Informations personnelles</h2>
            <p class="settings-section-desc">Ces informations apparaissent sur votre profil public.</p>
          </div>
          <form id="profile-form">
            <div class="pd-grid-2">
              <div class="auth-field"><label class="label">Prénom</label><input class="input" id="p-firstname"></div>
              <div class="auth-field"><label class="label">Nom</label><input class="input" id="p-lastname"></div>
            </div>
            <div class="auth-field"><label class="label">Email</label><input class="input" id="p-email" disabled style="opacity:0.6;"></div>
            <div class="auth-field"><label class="label">Bio</label><textarea class="input" id="p-bio" rows="3" maxlength="1000" style="resize:vertical;"></textarea></div>
            <button type="submit" class="btn-primary" style="font-size:13px; padding:8px 18px;">Enregistrer</button>
          </form>
        </section>

        <!-- Onglet Boutique -->
        <section class="card settings-card" id="tab-store" style="display:none;">
          <div id="no-store-view" style="display:none; text-align:center; padding:12px 0 24px;">
            <p style="margin-bottom:16px; color:var(--text-muted);">Vous n'avez pas encore de boutique.</p>
            <form id="create-store-form" style="max-width:360px; margin:0 auto; text-align:left;">
              <div class="auth-field"><label class="label">Nom de la boutique *</label><input class="input" id="cs-name" required></div>
              <div class="auth-field"><label class="label">Description</label><textarea class="input" id="cs-description" rows="2" style="resize:vertical;"></textarea></div>
              <div class="pd-grid-2">
                <div class="auth-field"><label class="label">Devise</label>
                  <select class="select-control" id="cs-currency"><option value="XOF">XOF</option><option value="EUR">EUR</option><option value="USD">USD</option></select>
                </div>
                <div class="auth-field"><label class="label">Pays</label><input class="input" id="cs-country" value="SN" maxlength="2"></div>
              </div>
              <button type="submit" class="btn-primary" style="width:100%; font-size:13px;">Créer ma boutique</button>
            </form>
          </div>

          <form id="store-form" style="display:none;">
            <div class="settings-section-header">
              <h2 class="settings-section-title">Votre boutique</h2>
              <p class="settings-section-desc">Slug public : <code id="s-slug"></code></p>
            </div>

            <!-- Bannière + Logo -->
            <div class="pd-grid-2" style="gap:16px; align-items:start;">
              <div class="auth-field">
                <label class="label">Logo de la boutique</label>
                <div style="display:flex; align-items:center; gap:12px;">
                  <div id="s-logo-preview" style="width:64px; height:64px; border-radius:12px; background:var(--surface-2); display:flex; align-items:center; justify-content:center; overflow:hidden; font-size:24px; color:var(--text-muted);">
                    <i class="fa-solid fa-store" aria-hidden="true"></i>
                  </div>
                  <div style="flex:1;">
                    <input type="file" id="s-logo-file" accept="image/png,image/jpeg,image/webp" style="font-size:12px;">
                    <p style="font-size:11px; color:var(--text-muted); margin-top:4px;">PNG, JPG ou WEBP. 5 Mo max.</p>
                  </div>
                </div>
              </div>
              <div class="auth-field">
                <label class="label">Couleur principale</label>
                <div class="color-picker-wrap">
                  <div class="color-picker-current">
                    <input type="color" id="s-color" class="color-picker-input" value="#e01b24">
                    <div class="color-picker-info">
                      <span class="color-picker-label">Couleur actuelle</span>
                      <span class="color-picker-hex" id="s-color-hex">#E01B24</span>
                    </div>
                  </div>
                  <div class="color-picker-swatches">
                    <button type="button" class="color-swatch" data-color="#E01B24" style="background:#E01B24" title="Rouge"></button>
                    <button type="button" class="color-swatch" data-color="#0EA5E9" style="background:#0EA5E9" title="Bleu"></button>
                    <button type="button" class="color-swatch" data-color="#10B981" style="background:#10B981" title="Vert"></button>
                    <button type="button" class="color-swatch" data-color="#8B5CF6" style="background:#8B5CF6" title="Violet"></button>
                    <button type="button" class="color-swatch" data-color="#F59E0B" style="background:#F59E0B" title="Orange"></button>
                    <button type="button" class="color-swatch" data-color="#EC4899" style="background:#EC4899" title="Rose"></button>
                    <button type="button" class="color-swatch" data-color="#111827" style="background:#111827" title="Noir"></button>
                  </div>
                </div>
              </div>
            </div>

            <div class="auth-field">
              <label class="label">Bannière de la boutique</label>
              <div id="s-banner-preview" style="width:100%; height:120px; border-radius:12px; background:var(--surface-2) center/cover no-repeat; display:flex; align-items:center; justify-content:center; color:var(--text-muted); font-size:13px; margin-bottom:8px;">
                <span>Aucune bannière</span>
              </div>
              <input type="file" id="s-banner-file" accept="image/png,image/jpeg,image/webp" style="font-size:12px;">
              <p style="font-size:11px; color:var(--text-muted); margin-top:4px;">Recommandé : 1200×400 px. PNG, JPG ou WEBP. 5 Mo max.</p>
              <p style="font-size:11px; color:var(--text-muted); margin-top:6px;">Si aucune bannière n'est définie, l'image du dernier produit publié sera utilisée automatiquement sur votre vitrine.</p>
            </div>

            <div class="auth-field"><label class="label">Nom</label><input class="input" id="s-name"></div>
            <div class="auth-field"><label class="label">Description</label><textarea class="input" id="s-description" rows="3" style="resize:vertical;"></textarea></div>
            <div class="auth-field"><label class="label">Site web</label><input class="input" type="url" id="s-website" placeholder="https://..."></div>
            <div class="pd-grid-2">
              <div class="auth-field"><label class="label">Instagram</label><input class="input" id="s-instagram"></div>
              <div class="auth-field"><label class="label">Twitter / X</label><input class="input" id="s-twitter"></div>
            </div>

            <!-- NOUVEAUX PARAMETRES -->
            <div class="settings-section-header" style="margin-top:24px;">
              <h3 class="settings-section-title" style="font-size:15px;">Identite & contact</h3>
              <p class="settings-section-desc">Ces informations sont visibles sur votre vitrine publique.</p>
            </div>

            <div class="auth-field">
              <label class="label">Slogan / accroche</label>
              <input class="input" id="s-tagline" maxlength="200" placeholder="Ex: Des produits hors normes, livres en 24h">
            </div>

            <div class="pd-grid-2">
              <div class="auth-field">
                <label class="label">Email de contact</label>
                <input class="input" type="email" id="s-contact-email" placeholder="contact@exemple.com">
              </div>
              <div class="auth-field">
                <label class="label">Telephone / WhatsApp</label>
                <input class="input" type="tel" id="s-contact-phone" placeholder="+221 77 000 00 00">
              </div>
            </div>

            <div class="pd-grid-2">
              <div class="auth-field">
                <label class="label">Devise par defaut</label>
                <select class="select-control" id="s-default-currency">
                  <option value="">-- Aucune --</option>
                  <option value="XOF">XOF (FCFA)</option>
                  <option value="EUR">EUR (€)</option>
                  <option value="USD">USD ($)</option>
                  <option value="MAD">MAD (DH)</option>
                  <option value="CAD">CAD ($)</option>
                </select>
              </div>
            </div>

            <div class="settings-section-header" style="margin-top:24px;">
              <h3 class="settings-section-title" style="font-size:15px;">Annonce vitrine</h3>
              <p class="settings-section-desc">Un bandeau court affiche en haut de votre boutique.</p>
            </div>

            <div class="auth-field">
              <label class="label">Texte de l'annonce</label>
              <input class="input" id="s-announcement" maxlength="300" placeholder="Ex: -20% sur tout jusqu'a dimanche minuit !">
              <label style="display:flex; align-items:center; gap:8px; margin-top:10px; font-size:13px; cursor:pointer;">
                <input type="checkbox" id="s-announcement-active">
                <span>Afficher cette annonce en haut de ma vitrine</span>
              </label>
            </div>

            <button type="submit" class="btn-primary" style="font-size:13px; padding:8px 18px; margin-top:20px;">Enregistrer</button>
          </form>
        </section>

        <!-- Onglet Paiement -->
        <section class="card settings-card" id="tab-payment" style="display:none;">
          <div class="settings-section-header">
            <h2 class="settings-section-title">Méthodes de paiement</h2>
            <p class="settings-section-desc">Vos retraits seront envoyés vers l'un de ces comptes, choisi au moment de la demande.</p>
          </div>
          <div id="payment-accounts-list"><div class="skeleton" style="height:60px;"></div></div>
          <button type="button" id="add-account-btn" class="add-account-btn">+ Ajouter un compte de paiement</button>
        </section>

        <!-- Onglet Sécurité -->
        <section class="card settings-card" id="tab-security" style="display:none;">
          <div class="settings-section-header">
            <h2 class="settings-section-title">Mot de passe</h2>
          </div>
          <div style="background:#FFFBEB; border:1px solid #FDE68A; color:#92400E; border-radius:12px; padding:12px 14px; font-size:13px; margin-bottom:16px;">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Le changement de mot de passe n'est pas encore connecté côté serveur. Aperçu visuel uniquement.
          </div>
          <form id="password-form">
            <div class="auth-field"><label class="label">Mot de passe actuel</label><input class="input" type="password" disabled></div>
            <div class="auth-field"><label class="label">Nouveau mot de passe</label><input class="input" type="password" disabled></div>
            <button type="submit" class="btn-secondary" disabled style="font-size:13px; padding:8px 18px; opacity:0.5; cursor:not-allowed;">Mettre à jour (indisponible)</button>
          </form>
        </section>

      </main>
    </div>
  </div>

  <!-- Modale ajout de compte de paiement -->
  <dialog id="account-dialog" class="product-dialog" style="max-width:420px;">
    <form id="account-form">
      <div class="pd-header">
        <h3 class="section-title" style="font-size:17px;">Ajouter un compte</h3>
        <button type="button" id="account-dialog-close" style="border:none; background:none; font-size:20px; color:var(--text-muted);">&times;</button>
      </div>
      <div class="pd-body">
        <div class="auth-field">
          <label class="label">Méthode *</label>
          <select class="select-control" id="acc-method" required>
            <option value="ORANGE_MONEY">Orange Money</option>
            <option value="WAVE">Wave</option>
            <option value="MTN_MONEY">MTN Mobile Money</option>
            <option value="BANK_TRANSFER">Virement bancaire</option>
          </select>
        </div>
        <div class="auth-field">
          <label class="label">Libellé (optionnel)</label>
          <input class="input" id="acc-label" placeholder="Ex : Mon Orange Money principal">
        </div>
        <div class="auth-field">
          <label class="label">Numéro / IBAN *</label>
          <input class="input" id="acc-number" required placeholder="+221 77 123 45 67">
        </div>
      </div>
      <div class="pd-footer">
        <button type="button" id="account-cancel" class="btn-secondary" style="padding:8px 18px; font-size:13px;">Annuler</button>
        <button type="submit" class="btn-primary" style="padding:8px 18px; font-size:13px;">Ajouter</button>
      </div>
    </form>
  </dialog>

  <script src="../assets/js/core/api.js"></script>
  <script src="../assets/js/core/icons.js"></script>
  <script src="../assets/js/core/page-transition.js"></script>
  <script src="../assets/js/core/password-toggle.js"></script>
  <script src="../assets/js/components/dashboard-shell.js"></script>
  <script src="../assets/js/pages/dashboard/settings.js"></script>
</body>
</html>